# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/

# Runtime data — 程序缓存与运行态
data/*.json
data/*.lock
*.log
*.lock
.agent-hub.pid

# 业务运行态数据（任务执行产物、并行临时目录，不入库）
business/tasks/
business/workspaces/*/_parallel/
business/workspaces/*/.opencode/
business/regression/artifacts/
business/regression/forensics/

# Skill 运行态产物（agent 自动提取草案 + skill review 待审批包，运行时生成）
business/skills/auto-*/
business/skills/_pending/

# Hub 运行时操作元数据（运行时生成，不入库）
business/config/hub_operation_meta.json

# SQLite 运行态真相库（D13）— 运行时生成，不入库
business/tasks/state.db
business/tasks/state.db-wal
business/tasks/state.db-shm

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.tmp-*
/tmp/
.gstack/

# Node (means / skills local deps)
**/node_modules/
frontend/dist/

# Regression forensics (large, reproducible locally)
business/regression/artifacts/

# Cursor auto-generated symlinks
.cursor/skills/
.cursor/hooks.json

# 一次性生成的 HTML 报告
myteam-test-report/
myteam-user-manual/
agent-upgrade-report/
business/experiments/

# understand-anything 缓存
.understand-anything/intermediate/
.understand-anything/tmp/

# playwright-mcp 运行时产物
business/workspaces/*/.playwright-mcp/
