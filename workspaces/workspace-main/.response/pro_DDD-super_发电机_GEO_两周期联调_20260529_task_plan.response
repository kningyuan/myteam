{
  "phases": [
    {
      "name": "基线审计与基础设施搭建",
      "type": "one_time",
      "description": "完成项目前期准备：建立基线数据、搭建监控基础设施、制定评估标准",
      "interval_days": null,
      "tasks": [
        {
          "id": "task_001",
          "name": "GEO基线数据收集与审计",
          "agent": "researcher",
          "task_type": "research",
          "reviewer": "main",
          "description": "收集当前GEO数据，分析基线表现，识别优化空间",
          "dependencies": [],
          "can_output_adjustments": true
        },
        {
          "id": "task_002",
          "name": "效果跟踪指标体系设计",
          "agent": "analyst",
          "task_type": "strategy",
          "reviewer": "main",
          "description": "设计GEO效果跟踪的指标体系和评估框架",
          "dependencies": [
            "task_001"
          ],
          "can_output_adjustments": false
        },
        {
          "id": "task_003",
          "name": "监控基础设施搭建",
          "agent": "developer",
          "task_type": "code-deliverable",
          "reviewer": "main",
          "description": "搭建自动化数据收集、效果跟踪和报告生成工具",
          "dependencies": [
            "task_002"
          ],
          "can_output_adjustments": false
        },
        {
          "id": "task_004",
          "name": "联调验证测试计划",
          "agent": "tester",
          "task_type": "test-plan",
          "reviewer": "main",
          "description": "制定两周期联调验证方案，确保Deputy cycle_review机制可用",
          "dependencies": [
            "task_003"
          ],
          "can_output_adjustments": true
        }
      ]
    },
    {
      "name": "双周优化循环",
      "type": "recurring",
      "description": "每两周执行一次GEO内容优化和效果评估，持续迭代提升",
      "interval_days": 14,
      "tasks": [
        {
          "id": "task_005",
          "name": "内容优化执行",
          "agent": "content",
          "task_type": "content",
          "reviewer": "main",
          "description": "根据效果数据优化GEO相关内容",
          "dependencies": [],
          "can_output_adjustments": true
        },
        {
          "id": "task_006",
          "name": "效果数据分析",
          "agent": "analyst",
          "task_type": "research",
          "reviewer": "main",
          "description": "分析优化效果，输出数据报告和洞察",
          "dependencies": [
            "task_005"
          ],
          "can_output_adjustments": true
        },
        {
          "id": "task_007",
          "name": "联调验证执行",
          "agent": "tester",
          "task_type": "test-plan",
          "reviewer": "main",
          "description": "执行两周期联调验证，验证Deputy cycle_review机制",
          "dependencies": [
            "task_006"
          ],
          "can_output_adjustments": false
        }
      ]
    },
    {
      "name": "月度综合评估",
      "type": "recurring",
      "description": "每月进行一次全面评估，调整优化策略和循环参数",
      "interval_days": 30,
      "tasks": [
        {
          "id": "task_008",
          "name": "月度综合评估报告",
          "agent": "analyst",
          "task_type": "research",
          "reviewer": "main",
          "description": "汇总月度数据，评估整体GEO优化效果",
          "dependencies": [],
          "can_output_adjustments": true
        },
        {
          "id": "task_009",
          "name": "策略调整建议",
          "agent": "researcher",
          "task_type": "strategy",
          "reviewer": "main",
          "description": "基于评估结果提出策略调整建议",
          "dependencies": [
            "task_008"
          ],
          "can_output_adjustments": true
        }
      ]
    }
  ]
}