{
  "phases": [
    {
      "name": "基线审计与准备",
      "type": "one_time",
      "description": "完成现有知识库内容盘点、缺口分析、质量门禁搭建、发布流程验证",
      "tasks": [
        {
          "id": "task_001",
          "name": "现有内容盘点与分类",
          "agent": "researcher",
          "task_type": "research",
          "description": "全面盘点Claw知识库现有内容，按主题/质量/时效性分类，建立内容清单",
          "dependencies": [],
          "can_output_adjustments": false
        },
        {
          "id": "task_002",
          "name": "知识缺口分析",
          "agent": "analyst",
          "task_type": "research",
          "description": "基于盘点结果，识别内容缺口、重复内容、过时内容，输出缺口优先级矩阵",
          "dependencies": [
            "task_001"
          ],
          "can_output_adjustments": true
        },
        {
          "id": "task_003",
          "name": "内容质量标准与模板制定",
          "agent": "content",
          "task_type": "docs",
          "description": "制定内容质量标准、文章模板、SEO规范，确保后续内容一致性",
          "dependencies": [
            "task_002"
          ],
          "can_output_adjustments": false
        },
        {
          "id": "task_004",
          "name": "质量门禁测试框架搭建",
          "agent": "tester",
          "task_type": "test-plan",
          "description": "设计内容质量门禁检查清单，包括事实核查、格式规范、SEO评分等",
          "dependencies": [
            "task_003"
          ],
          "can_output_adjustments": false
        },
        {
          "id": "task_005",
          "name": "发布流程基础设施验证",
          "agent": "ops",
          "task_type": "strategy",
          "description": "验证publish-post发布流程，确保浏览器自动化发布与截图留证流程可用",
          "dependencies": [
            "task_004"
          ],
          "can_output_adjustments": false
        }
      ]
    },
    {
      "name": "内容审核与创作",
      "type": "recurring",
      "description": "每周执行内容审核、缺口填补、新文章创作与质量门禁审核",
      "interval_days": 7,
      "tasks": [
        {
          "id": "task_006",
          "name": "周度内容审核",
          "agent": "researcher",
          "task_type": "research",
          "description": "审核现有内容时效性，标记需更新/归档/删除的文章",
          "dependencies": [],
          "can_output_adjustments": false
        },
        {
          "id": "task_007",
          "name": "新文章撰写",
          "agent": "content",
          "task_type": "content",
          "description": "根据缺口优先级撰写新文章，遵循质量标准和模板",
          "dependencies": [
            "task_006"
          ],
          "can_output_adjustments": false
        },
        {
          "id": "task_008",
          "name": "质量门禁审核",
          "agent": "tester",
          "task_type": "test-plan",
          "description": "对新文章执行质量门禁检查，出具审核报告",
          "dependencies": [
            "task_007"
          ],
          "can_output_adjustments": false
        },
        {
          "id": "task_009",
          "name": "发布与留证",
          "agent": "ops",
          "task_type": "strategy",
          "description": "通过质量门禁的文章执行publish-post发布，截图留证",
          "dependencies": [
            "task_008"
          ],
          "can_output_adjustments": false
        }
      ]
    },
    {
      "name": "月度评估与优化",
      "type": "recurring",
      "description": "每月评估知识库整体质量、内容表现、流程效率，提出优化建议",
      "interval_days": 30,
      "tasks": [
        {
          "id": "task_010",
          "name": "知识库质量指标评估",
          "agent": "analyst",
          "task_type": "research",
          "description": "统计月度内容增长量、质量门禁通过率、发布成功率等指标",
          "dependencies": [],
          "can_output_adjustments": false
        },
        {
          "id": "task_011",
          "name": "流程效率与策略优化建议",
          "agent": "ops",
          "task_type": "strategy",
          "description": "基于评估结果，提出发布流程优化、循环间隔调整、新增任务等建议",
          "dependencies": [
            "task_010"
          ],
          "can_output_adjustments": true
        }
      ]
    }
  ]
}