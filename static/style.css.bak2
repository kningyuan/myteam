* { margin:0; padding:0; box-sizing:border-box; }

:root {
  /* 品牌色系 - 深空紫（专业+神秘感，避免通用科技蓝） */
  --primary: #6366f1;
  --primary-hover: #4f46e5;
  --primary-light: rgba(99, 102, 241, 0.12);

  /* 背景 - 三层深度系统 */
  --bg-base: #0a0a0f;        /* 最深层 - 主背景 */
  --bg-elevated: #16161d;    /* 卡片层 - 侧边栏/卡片 */
  --bg-interactive: #1e1e28; /* 交互层 - 悬停/输入框 */
  --bg-overlay: rgba(10, 10, 15, 0.8); /* 遮罩层 */

  /* 文字 - 四级层级 */
  --text-primary: #e4e4e7;   /* 主要文字 */
  --text-secondary: #a1a1aa; /* 次要文字 */
  --text-tertiary: #71717a;  /* 辅助文字 */
  --text-disabled: #52525b;  /* 禁用文字 */

  /* 边框 */
  --border: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(255, 255, 255, 0.12);

  /* 功能色 */
  --success: #10b981;
  --success-light: rgba(16, 185, 129, 0.12);
  --warning: #f59e0b;
  --warning-light: rgba(245, 158, 11, 0.12);
  --error: #ef4444;
  --error-light: rgba(239, 68, 68, 0.12);
  --info: #3b82f6;

  /* 品牌渐变 */
  --gradient-brand: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --gradient-subtle: linear-gradient(180deg, rgba(99, 102, 241, 0.05) 0%, transparent 100%);

  /* 字体 */
  --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  --font-mono: 'SF Mono', 'Fira Code', 'Consolas', monospace;

  /* 圆角系统 */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;

  /* 间距系统（4px 基准） */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;

  /* 阴影层级 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.12);
  --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.16);
  --shadow-lg: 0 4px 16px rgba(0, 0, 0, 0.20);
  --shadow-xl: 0 8px 32px rgba(0, 0, 0, 0.24);

  /* 过渡 */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

html, body {
  height: 100%;
  background: var(--bg-base);
  color: var(--text-primary);
  font-family: var(--font);
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Top Nav - 提升品牌感 */
#top-nav {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-2) var(--space-6);
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
  height: 56px;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.nav-logo {
  font-weight: 600;
  font-size: 16px;
  background: var(--gradient-brand);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -0.02em;
}

.nav-tabs {
  display: flex;
  gap: var(--space-1);
  flex: 1;
  padding: var(--space-1);
  background: var(--bg-base);
  border-radius: var(--radius-lg);
}

.nav-tab {
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  border: none;
  background: transparent;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.nav-tab:hover {
  background: var(--bg-interactive);
  color: var(--text-primary);
}

.nav-tab.active {
  background: var(--primary);
  color: #fff;
  box-shadow: var(--shadow-sm);
}

#status-badge {
  font-size: 11px;
  font-weight: 500;
  padding: var(--space-1) var(--space-3);
  border-radius: 12px;
  letter-spacing: 0.02em;
}

.status.online {
  background: var(--success-light);
  color: var(--success);
}

.status.busy {
  background: var(--warning-light);
  color: var(--warning);
}

/* Layout */
#main-layout { display:flex; height:calc(100vh - 48px); }

/* Sidebar */
#sidebar { width:240px; min-width:240px; background:var(--bg2); border-right:1px solid var(--border); display:flex; flex-direction:column; }
.sidebar-panel { display:none; flex-direction:column; height:100%; }
.sidebar-panel.active { display:flex; }
.sidebar-title {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 14px; border-bottom:1px solid var(--border); font-size:13px; font-weight:500;
}
.badge { background:var(--surf); padding:1px 8px; border-radius:10px; font-size:11px; }
.sidebar-list { flex:1; overflow-y:auto; padding:6px; }

.sidebar-item {
  padding:8px 10px; border-radius:6px; cursor:pointer; margin-bottom:2px;
  display:flex; align-items:center; gap:8px; font-size:13px; transition:background .1s;
}
.sidebar-item:hover { background:var(--surf); }
.sidebar-item.active { background:var(--surf); outline:1px solid var(--accent); }
.sidebar-item .s-icon { width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; background:var(--surf); flex-shrink:0; }
.sidebar-item .s-name { flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.sidebar-item .s-sub { font-size:10px; color:var(--text3); }
.btn-sm { background:var(--surf); border:none; color:var(--text2); width:24px; height:24px; border-radius:4px; cursor:pointer; font-size:14px; display:flex; align-items:center; justify-content:center; }
.btn-sm:hover { background:var(--surf-hover); color:var(--text); }

/* Main content */
#content { flex:1; display:flex; flex-direction:column; min-width:0; }
.tab-content { display:none; flex:1; }
.tab-content.active { display:flex; flex-direction:column; }

/* Welcome */
.welcome { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; color:var(--text3); }
.welcome-icon { font-size:40px; opacity:.4; }
.welcome h2 { font-size:17px; color:var(--text2); font-weight:500; }
.welcome p { font-size:13px; }

/* Chat View */
.chat-view { display:flex; flex-direction:column; height:100%; }
.chat-view.hidden { display:none; }
.chat-header {
  padding:10px 16px; border-bottom:1px solid var(--border); background:var(--bg3);
  display:flex; align-items:center; justify-content:space-between; flex-shrink:0;
}
.agent-info { display:flex; align-items:center; gap:8px; }
.agent-avatar { width:32px; height:32px; border-radius:50%; background:var(--surf); display:flex; align-items:center; justify-content:center; font-size:15px; }
.agent-name { font-size:14px; font-weight:500; }
.agent-id { font-size:10px; color:var(--text3); display:block; }
.chat-actions { display:flex; gap:4px; }
.btn-icon { background:none; border:none; color:var(--text3); cursor:pointer; font-size:14px; padding:4px; border-radius:4px; }
.btn-icon:hover { background:var(--surf); color:var(--text); }

/* Messages */
.messages { flex:1; overflow-y:auto; padding:12px 16px; display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth; }
.message { max-width:85%; animation:fadeIn .2s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:translateY(0)} }
.message.user { align-self:flex-end; }
.message.agent { align-self:flex-start; }
.message.system { align-self:center; font-size:11px; color:var(--text3); max-width:100%; }
.msg-content { padding:8px 12px; border-radius:10px; font-size:13px; line-height:1.5; white-space:pre-wrap; word-wrap:break-word; }
.message.user .msg-content { background:var(--accent); color:#fff; border-bottom-right-radius:4px; }
.message.agent .msg-content { background:var(--surf); border:1px solid var(--border); border-bottom-left-radius:4px; }
.msg-header { font-size:10px; color:var(--text3); margin-bottom:3px; display:flex; align-items:center; gap:4px; }
.msg-agent-icon { width:16px; height:16px; border-radius:50%; background:var(--surf); display:inline-flex; align-items:center; justify-content:center; font-size:9px; }
.msg-content.error { background:rgba(239,68,68,.12); border-color:rgba(239,68,68,.3); color:var(--red); }

/* Thinking section */
.thinking-section { margin-top:6px; border:1px solid var(--border); border-radius:6px; overflow:hidden; background:#16181e; }
.thinking-header { display:flex; align-items:center; gap:4px; padding:4px 8px; font-size:11px; color:var(--yellow); cursor:pointer; user-select:none; border-bottom:1px solid var(--border); }
.thinking-toggle { font-size:9px; transition:transform .15s; }
.thinking-section.collapsed .thinking-toggle { transform:rotate(-90deg); }
.thinking-section.collapsed .thinking-body { display:none; }
.thinking-body { padding:6px 8px; font-size:11px; line-height:1.4; max-height:250px; overflow-y:auto; }
.thinking-text { white-space:pre-wrap; color:var(--text2); }
.thinking-text.streaming { animation:pulse 1.5s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.5} }
.tool-call { padding:3px 6px; margin:3px 0; background:rgba(59,130,246,.08); border-left:2px solid var(--accent); border-radius:3px; font-family:var(--mono); font-size:10px; color:var(--accent); }
.tool-result-block { margin:3px 0; }
.tool-result-block details { font-size:10px; }
.tool-result-block summary { cursor:pointer; color:var(--text3); padding:2px 0; }
.tool-result-content { margin-top:3px; padding:6px; background:#111; border-radius:3px; font-family:var(--mono); font-size:10px; color:var(--green); max-height:120px; overflow-y:auto; white-space:pre-wrap; }
.step-finish { padding:1px 6px; font-size:9px; color:var(--text3); text-align:right; }
.typing-dots { display:flex; gap:3px; padding:4px 0; }
.typing-dots span { width:5px; height:5px; border-radius:50%; background:var(--text3); animation:bounce 1.4s infinite; }
.typing-dots span:nth-child(2) { animation-delay:.2s; }
.typing-dots span:nth-child(3) { animation-delay:.4s; }
@keyframes bounce { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-4px)} }

/* Input */
.input-area { padding:10px 16px 12px; border-top:1px solid var(--border); background:var(--bg3); display:flex; gap:8px; align-items:flex-end; position:relative; }
#message-input, #group-input { flex:1; padding:8px 12px; border:1px solid var(--border); border-radius:8px; background:var(--surf); color:var(--text); font-size:13px; font-family:inherit; resize:none; outline:none; transition:border-color .15s; line-height:1.4; }
#message-input:focus, #group-input:focus { border-color:var(--accent); }
#message-input::placeholder { color:var(--text3); }
#btn-send, #btn-group-send { padding:8px 18px; border:none; border-radius:8px; background:var(--accent); color:#fff; font-size:13px; font-weight:500; cursor:pointer; transition:background .15s; white-space:nowrap; }
#btn-send:hover:not(:disabled), #btn-group-send:hover:not(:disabled) { background:var(--accent-hover); }
#btn-send:disabled, #btn-group-send:disabled { opacity:.4; cursor:not-allowed; }

/* @mention autocomplete dropdown */
.mention-dropdown {
  position:absolute; bottom:100%; left:16px; right:16px;
  max-height:200px; overflow-y:auto;
  background:var(--bg2); border:1px solid var(--border); border-radius:8px;
  box-shadow:0 -4px 12px rgba(0,0,0,.3); z-index:50;
}
.mention-item {
  padding:8px 12px; font-size:13px; cursor:pointer;
  display:flex; align-items:center; gap:8px;
}
.mention-item:hover, .mention-item.active { background:var(--surf); }
.mention-item .m-icon { width:20px; height:20px; border-radius:50%; background:var(--surf); display:flex; align-items:center; justify-content:center; font-size:10px; }
.mention-item .m-name { font-weight:500; }
.mention-item .m-id { font-size:11px; color:var(--text3); }

.create-panel { padding:30px 40px; overflow-y:auto; }
.create-panel h2 { font-size:20px; margin-bottom:4px; }
.create-panel .subtitle { color:var(--text3); font-size:13px; margin-bottom:24px; }
.create-form { max-width:600px; }
.form-group { margin-bottom:14px; }
.form-group label { display:block; font-size:12px; font-weight:500; margin-bottom:4px; color:var(--text2); }
.required { color:var(--red); }
.form-group textarea, .form-group input, .form-group select {
  width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px;
  background:var(--surf); color:var(--text); font-size:13px; font-family:inherit; outline:none;
}
.form-group textarea:focus, .form-group input:focus, .form-group select:focus { border-color:var(--accent); }
.form-row { display:flex; gap:12px; }
.flex-1 { flex:1; }
.form-status { padding:8px 12px; border-radius:6px; margin-bottom:12px; font-size:12px; display:none; }
.form-status.error { display:block; background:rgba(239,68,68,.1); color:var(--red); }
.form-status.success { display:block; background:rgba(34,197,94,.1); color:var(--green); }
.btn-primary {
  padding:8px 20px; border:none; border-radius:8px; background:var(--accent); color:#fff;
  font-size:13px; font-weight:500; cursor:pointer; transition:background .15s;
}
.btn-primary:hover { background:var(--accent-hover); }
.btn-secondary { padding:8px 20px; border:1px solid var(--border); border-radius:8px; background:transparent; color:var(--text2); font-size:13px; cursor:pointer; }
.btn-secondary:hover { background:var(--surf); }
.create-result { max-width:600px; padding:16px; border:1px solid var(--green); border-radius:8px; background:rgba(34,197,94,.05); }
.create-result h3 { margin-bottom:8px; font-size:15px; }
.result-details { font-size:12px; color:var(--text2); line-height:1.6; }
.result-details div { margin-bottom:3px; }

/* ============== Modals ============== */
.modal { position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.6); display:flex; align-items:center; justify-content:center; z-index:100; }
.modal.hidden { display:none; }
.modal-content { background:var(--bg2); border:1px solid var(--border); border-radius:12px; width:420px; max-height:80vh; overflow-y:auto; }
.modal-header { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--border); }
.modal-header h3 { font-size:15px; }
.modal-close { background:none; border:none; color:var(--text3); font-size:18px; cursor:pointer; padding:2px 6px; border-radius:4px; }
.modal-close:hover { background:var(--surf); }
.modal-body { padding:16px 18px; }
.modal-footer { display:flex; gap:8px; justify-content:flex-end; padding:12px 18px; border-top:1px solid var(--border); }

/* Member list */
.member-list { display:flex; flex-wrap:wrap; gap:6px; }
.member-tag { display:inline-flex; align-items:center; gap:4px; padding:4px 8px; background:var(--surf); border-radius:4px; font-size:12px; }
.member-remove { background:none; border:none; color:var(--red); cursor:pointer; font-size:12px; padding:0 2px; }
.add-member-row { display:flex; gap:8px; }
.add-member-row select { flex:1; padding:6px 8px; border:1px solid var(--border); border-radius:6px; background:var(--surf); color:var(--text); font-size:12px; }

/* Misc */
.hidden { display:none !important; }
.loading, .empty { text-align:center; color:var(--text3); padding:20px; font-size:12px; }
::-webkit-scrollbar { width:5px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--border); border-radius:3px; }
::-webkit-scrollbar-thumb:hover { background:var(--text3); }

/* Group message styling */
.message.group-user { align-self:flex-end; }
.message.group-agent { align-self:flex-start; }
.message.group-agent .msg-content { background:var(--surf); border:1px solid var(--border); border-bottom-left-radius:4px; }
.message.group-user .msg-content { background:rgba(59,130,246,.15); border:1px solid rgba(59,130,246,.25); border-bottom-right-radius:4px; }
.message.group-system { align-self:center; font-size:11px; color:var(--text3); max-width:100%; }

/* Agent thinking agent label */
.agent-thinking-label { font-size:10px; color:var(--yellow); margin-top:2px; }

/* ============== Management Panel ============== */
.manage-panel { padding:30px 40px; overflow-y:auto; height:100%; }
.manage-panel h2 { font-size:20px; margin-bottom:4px; display:inline; }
.manage-header { display:flex; align-items:center; gap:10px; margin-bottom:4px; }
.manage-header .badge { font-size:12px; padding:2px 10px; }
.manage-table { width:100%; border-collapse:collapse; font-size:13px; }
.manage-table th { text-align:left; padding:10px 12px; border-bottom:1px solid var(--border); color:var(--text2); font-weight:500; font-size:12px; }
.manage-table td { padding:8px 12px; border-bottom:1px solid var(--border); vertical-align:middle; }
.manage-table tr:hover td { background:var(--bg3); }
.manage-table .agent-cell { display:flex; align-items:center; gap:8px; }
.manage-table .agent-cell .icon { width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:14px; background:var(--surf); }
.manage-table select { padding:4px 8px; border:1px solid var(--border); border-radius:4px; background:var(--surf); color:var(--text); font-size:12px; }
.manage-table input { padding:4px 8px; border:1px solid var(--border); border-radius:4px; background:var(--surf); color:var(--text); font-size:12px; width:100%; min-width:60px; }
.btn-xs { padding:3px 10px; border:none; border-radius:4px; font-size:11px; cursor:pointer; white-space:nowrap; }
.btn-xs.primary { background:var(--accent); color:#fff; }
.btn-xs.primary:hover { background:var(--accent-hover); }
.btn-xs.danger { background:rgba(239,68,68,.15); color:var(--red); }
.btn-xs.danger:hover { background:rgba(239,68,68,.25); }

/* ============== Settings Panel ============== */
.settings-panel { padding:30px 40px; overflow-y:auto; }
.settings-panel h2 { font-size:20px; margin-bottom:4px; }
.settings-panel .subtitle { color:var(--text3); font-size:13px; margin-bottom:24px; }
.settings-form { max-width:500px; }