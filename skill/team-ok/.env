# ════════════════════════════════════════
# team-ok 全局配置
# 取消注释并修改值即可覆盖默认配置
# ════════════════════════════════════════

# ── Executor 轮询与超时 ──
# EXECUTOR_POLL_INTERVAL=5        # 轮询间隔（秒）
# EXECUTOR_ACK_TIMEOUT=300        # ACK 超时（秒）
# EXECUTOR_TASK_TIMEOUT=3600      # 任务等待超时（秒）
# EXECUTOR_EVALUATE_TIMEOUT=600   # 评估超时（秒）
# EXECUTOR_EXECUTE_TIMEOUT=3600   # 执行超时（秒，旧版硬编码值）

# ── Executor 重试 ──
# EXECUTOR_MAX_RETRIES=3          # 最大重试次数
# EXECUTOR_MAX_EVALUATE_RETRIES=3 # 评估最大重试
# EXECUTOR_MAX_EXECUTE_RETRIES=3  # 执行最大重试

# ── Executor 状态等待 ──
# TEAM_CONFIG_TIMEOUT=600         # 等待 Main Agent 配置团队（秒）
# TASK_PLAN_TIMEOUT=600           # 等待 Main Agent 规划任务（秒）
# TEAM_CONFIG_MAX_RETRIES=2       # 团队配置验证失败重试次数
# TASK_PLAN_MAX_RETRIES=3         # 任务规划验证失败重试次数
# NOTIFY_AGENT_TIMEOUT=300        # 通知 Main Agent 超时（秒）
# RETRY_DISPATCH_SLEEP=10         # 重试调度前等待（秒）

# ── Agent 消息 ──
# AGENT_MSG_TIMEOUT=1800          # openclaw agent 调用超时（秒）

# ── 握手 ACK ──
# HANDSHAKE_ACK_TIMEOUT=300       # 握手 ACK 超时（秒）
# HANDSHAKE_POLL_INTERVAL=5       # ACK 轮询间隔（秒）
# HANDSHAKE_PROC_WAIT_TIMEOUT=5   # 握手子进程等待超时（秒）

# ── Telegram 通知 ──
# TELEGRAM_CURL_TIMEOUT=60        # curl 请求超时（秒）
# TELEGRAM_MAX_RETRIES=2          # Telegram 发送重试次数
# GROUP_NOTIFY_TIMEOUT=30         # 群通报子进程超时（秒）
# GROUP_NOTIFY_URL_TIMEOUT=10     # 群通报直连 Telegram API 直连超时（秒）
# NOTIFY_EVENT_TIMEOUT=30         # 任务/子任务事件通知事件超时（秒）

# ── 各子命令调用超时 ──
# QUEUE_CMD_TIMEOUT=120           # task_queue.py 调用超时（秒）
# COMPLETE_CMD_TIMEOUT=120        # complete.py 调用超时（秒）
# PROJECT_DATA_CMD_TIMEOUT=120    # project_data.py 调用超时（秒）
# MEMORY_SAVE_TIMEOUT=30          # memory.py 保存超时（秒）
# DISPATCH_RETRY_SLEEP=5          # 派发重试前等待（秒）

# ── Resume 恢复 ──
# RESUME_CMD_TIMEOUT=120          # resume 通用超时（秒）
# RESUME_CMD_SHORT_TIMEOUT=5      # resume 短操作超时（秒）
# RESUME_RELEASE_TIMEOUT=30       # resume 释放队列超时（秒）
# RESUME_SLEEP_INTERVAL=30        # resume 轮询间隔（秒）

# ── 通用 ──
# SUBPROCESS_TIMEOUT=120          # _run_script 默认超时（秒）