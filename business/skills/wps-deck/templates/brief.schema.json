{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "deck_brief",
  "type": "object",
  "required": ["title", "slides"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "author": { "type": "string" },
    "template": { "enum": ["pitch", "report"] },
    "slides": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["title", "section", "content", "closing"] },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
