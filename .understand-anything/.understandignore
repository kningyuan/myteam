# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#

# --- From .gitignore (uncomment to exclude) ---

# *.py[cod]
# *$py.class
# *.so
# .Python
# env/
# ENV/
# config/*.json
# config/**/*.json
# data/*.json
# data/*.lock
# .agent-hub.pid
# business/workspaces/
# business/tasks/
# business/config/
# business/tasks/state.db
# business/tasks/state.db-wal
# business/tasks/state.db-shm
# *.swp
# *.swo
# *~
# .DS_Store
# Thumbs.db
# *.tmp
# .tmp-*
# /tmp/
# .gstack/
# **/node_modules/
# frontend/dist/
# business/regression/artifacts/
# .cursor/skills/
# .cursor/hooks.json
# myteam-test-report/
# myteam-user-manual/
# agent-upgrade-report/
# tasks/

# --- Test file patterns (uncomment to exclude) ---

# JS / TS
# *.test.*
# *.spec.*
# *.snap
# C# / .NET
# **/*Tests.cs
# **/*Test.cs
# **/*Fixture.cs
# **/*.Tests.csproj
# Java / Kotlin
# **/src/test/**
# **/*Test.java
# **/*IT.java
# **/*Spec.kt
# Go
# **/*_test.go
